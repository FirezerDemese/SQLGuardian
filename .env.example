# SQLGuardian - Local Docker Development
# Copy this to .env and never commit .env to git

SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=SQLGuardian@2024
SQL_SERVER_DATABASE=master

GUARDIAN_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/sqlguardian.log

# Thresholds
CPU_WARNING_PCT=75
CPU_CRITICAL_PCT=90
MEMORY_WARNING_PCT=80
MEMORY_CRITICAL_PCT=95
DISK_WARNING_PCT=80
DISK_CRITICAL_PCT=90
BLOCKING_WARNING_SECONDS=30
BLOCKING_CRITICAL_SECONDS=120

# Scheduler
HEALTH_CHECK_INTERVAL_SECONDS=60
JOB_CHECK_INTERVAL_SECONDS=120

# Narration model. Groq retires models on a published schedule
# (llama-3.3-70b-versatile and llama-3.1-8b-instant were retired 2026-08-16),
# so this is config, not code. Check https://console.groq.com/docs/models
# before changing it. GET /health/llm tells you whether the current id works.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Condition thresholds beyond the ones above
LOG_USED_WARNING_PCT=75
LOG_USED_CRITICAL_PCT=90
LONG_QUERY_WARNING_SECONDS=30
LONG_QUERY_CRITICAL_SECONDS=300
BACKUP_AGE_WARNING_HOURS=25
BACKUP_AGE_CRITICAL_HOURS=48

# Stop querying an instance for this long after a connection failure, so one
# unreachable instance cannot hang a snapshot request.
DB_UNREACHABLE_COOLDOWN_SECONDS=30

# Runbook corpus and incident history (on disk, survive a restart)
RUNBOOK_STORE_DIR=data/runbooks/store
INCIDENT_STORE_DIR=data/incidents
