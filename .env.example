# SQLGuardian - Local Docker Development
# Copy this to .env and never commit .env to git

SQL_SERVER_HOST=localhost
SQL_SERVER_PORT=1433
SQL_SERVER_USER=sa
SQL_SERVER_PASSWORD=SQLGuardian@2024
SQL_SERVER_DATABASE=master

GUARDIAN_ENV=development
LOG_LEVEL=INFO
LOG_FILE=logs/sqlguardian.log

# Thresholds
CPU_WARNING_PCT=75
CPU_CRITICAL_PCT=90
MEMORY_WARNING_PCT=80
MEMORY_CRITICAL_PCT=95
DISK_WARNING_PCT=80
DISK_CRITICAL_PCT=90
BLOCKING_WARNING_SECONDS=30
BLOCKING_CRITICAL_SECONDS=120

# Scheduler
HEALTH_CHECK_INTERVAL_SECONDS=60
JOB_CHECK_INTERVAL_SECONDS=120
